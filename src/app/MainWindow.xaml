<Window x:Class="Obhod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="обход" Width="1180" Height="800" MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#1C1C1E"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BitmapCache x:Key="BlobCache" RenderAtScale="0.75" SnapsToDevicePixels="False"/>
        <Style x:Key="BgGlass" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14FFFFFF" Offset="0"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="CacheMode" Value="{StaticResource BlobCache}"/>
        </Style>

        <!-- Форма «капли» жидкого стекла (координаты 0..1, растягивается) -->
        
        
        

        <!-- Заливка капли: почти чёрное стекло с мягким светом внутри -->
        
        <!-- Белые блики по краю капли -->
        
        

        <Storyboard x:Key="BlobsSb" RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="24">
            <DoubleAnimation Storyboard.TargetName="B1T" Storyboard.TargetProperty="X" From="0" To="40" Duration="0:0:21">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B1T" Storyboard.TargetProperty="Y" From="0" To="30" Duration="0:0:17">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B1R" Storyboard.TargetProperty="Angle" From="-2" To="2" Duration="0:0:25">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B2T" Storyboard.TargetProperty="X" From="0" To="-60" Duration="0:0:23">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B2T" Storyboard.TargetProperty="Y" From="0" To="30" Duration="0:0:19">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B2R" Storyboard.TargetProperty="Angle" From="2" To="-2" Duration="0:0:29">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B3T" Storyboard.TargetProperty="X" From="0" To="60" Duration="0:0:27">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B3T" Storyboard.TargetProperty="Y" From="0" To="-30" Duration="0:0:22">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B4T" Storyboard.TargetProperty="Y" From="0" To="-40" Duration="0:0:18">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B4R" Storyboard.TargetProperty="Angle" From="0" To="3" Duration="0:0:26">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SpinSb" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2"/>
        </Storyboard>

        <Geometry x:Key="PowerIcon">M 12,2.5 L 12,11 M 6.2,5.6 A 8.2,8.2 0 1 0 17.8,5.6</Geometry>
        <Geometry x:Key="PlaneIcon">M 21.5,3.2 L 2.6,10.5 C 1.8,10.8 1.8,11.9 2.7,12.1 L 7.4,13.6 L 9.2,19.3 C 9.4,20 10.3,20.2 10.8,19.7 L 13.5,17.1 L 18.1,20.5 C 18.7,20.9 19.5,20.6 19.7,19.9 L 22.9,4.5 C 23.1,3.6 22.3,2.9 21.5,3.2 Z M 9.6,14.2 L 18.4,7.1 L 10.6,15.3 L 10.3,17.9 Z</Geometry>

        <DataTemplate x:Key="ServiceTpl">
            <Border Margin="0,0,0,8" Padding="12,10,16,10" CornerRadius="26" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40">
                        <Ellipse Fill="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1"/>
                        <Path Data="{Binding Logo}" Fill="White" Stretch="Uniform" Width="19" Height="19" Visibility="{Binding LogoVisibility}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" Visibility="{Binding GlyphVisibility}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14.5"/>
                        <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="3" ToolTip="удалить" Visibility="{Binding RemoveVisibility}" Style="{StaticResource ChromeButton}"
                            Width="30" Height="30" Margin="0,0,10,0" Click="RemoveService_Click" Tag="{Binding}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                    <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center"
                              Click="ServiceToggle_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VpnRowTpl">
            <Border Margin="0,0,0,6" Padding="16,9" CornerRadius="24" Background="{Binding RowBrush}" BorderBrush="{Binding RowStroke}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="VpnRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Stroke="#66FFFFFF" StrokeThickness="1.2"/>
                        <Ellipse Width="10" Height="10" Fill="White" Visibility="{Binding DotVisibility}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PingText}" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" ToolTip="удалить" Style="{StaticResource ChromeButton}" Width="28" Height="28" Margin="0" Click="VpnRemove_Click" Tag="{Binding}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StrategyRowTpl">
            <Border Margin="0,0,0,6" Padding="18,10" CornerRadius="24" Background="{Binding RowBrush}" BorderBrush="{Binding RowStroke}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="12,0">
                        <Border CornerRadius="2" Background="#1AFFFFFF"/>
                        <Border CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{Binding BarBrush}"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CheckRowTpl">
            <Border Margin="0,0,0,6" Padding="18,9" CornerRadius="24" Background="#0AFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5"/>
                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="11" Padding="10,3" Margin="3,0" Background="{Binding T12Brush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="tls 1.2" FontSize="11" Foreground="{Binding T12Fg}"/></Border>
                        <Border CornerRadius="11" Padding="10,3" Margin="3,0" Background="{Binding T13Brush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="tls 1.3" FontSize="11" Foreground="{Binding T13Fg}"/></Border>
                        <Border CornerRadius="11" Padding="10,3" Margin="3,0" Background="{Binding StreamBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="64 кб" FontSize="11" Foreground="{Binding StreamFg}"/></Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding MsText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- ======= Фон: чёрный и плавающие капли жидкого стекла ======= -->
        <!-- Графитовый фон, как на примере -->
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BgBrush}"/>

        <!-- Плавающие стеклянные фигуры: круги, таблетки, скруглённые прямоугольники -->
        <Canvas IsHitTestVisible="False" Opacity="{DynamicResource ShapesOpacity}">
            <Border Style="{StaticResource BgGlass}" Width="300" Height="300" CornerRadius="150" Canvas.Left="-120" Canvas.Top="-150">
                <Border.RenderTransform><TransformGroup><RotateTransform x:Name="B1R"/><TranslateTransform x:Name="B1T"/></TransformGroup></Border.RenderTransform>
            </Border>
            <Border Style="{StaticResource BgGlass}" Width="460" Height="120" CornerRadius="60" Canvas.Left="760" Canvas.Top="-40">
                <Border.RenderTransform><TransformGroup><RotateTransform x:Name="B2R"/><TranslateTransform x:Name="B2T"/></TransformGroup></Border.RenderTransform>
            </Border>
            <Border Style="{StaticResource BgGlass}" Width="420" Height="180" CornerRadius="34" Canvas.Left="300" Canvas.Top="760">
                <Border.RenderTransform><TranslateTransform x:Name="B3T"/></Border.RenderTransform>
            </Border>
            <Border Style="{StaticResource BgGlass}" Width="180" Height="180" CornerRadius="90" Canvas.Left="1080" Canvas.Top="650">
                <Border.RenderTransform><TransformGroup><RotateTransform x:Name="B4R"/><TranslateTransform x:Name="B4T"/></TransformGroup></Border.RenderTransform>
            </Border>
            <Border Style="{StaticResource BgGlass}" Width="70" Height="70" CornerRadius="35" Canvas.Left="300" Canvas.Top="-22"/>
            <Border Style="{StaticResource BgGlass}" Width="54" Height="54" CornerRadius="27" Canvas.Left="382" Canvas.Top="-6"/>
            <Border Style="{StaticResource BgGlass}" Width="220" Height="90" CornerRadius="24" Canvas.Left="-170" Canvas.Top="620"/>
        </Canvas>

        <Grid Margin="26,0,26,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======= Заголовок ======= -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="обход" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="23" Margin="14,0,0,3" VerticalAlignment="Center"/>
                    <Border CornerRadius="12" Padding="10,3" Margin="14,2,0,0" VerticalAlignment="Center" Background="#0DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="VersionText" Text="запрет · telegram · vpn" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeBtn" Style="{StaticResource ChromeButton}" Click="Theme_Click" ToolTip="тема: графит или чёрная">
                        <Path Data="M 9,1 A 8,8 0 1 0 17,9 A 6,6 0 1 1 9,1 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="OpenSettings_Click" ToolTip="настройки и обновления">
                        <Path Data="M 8,0 L 10,0 L 10.5,2.5 L 12.6,3.4 L 14.7,2 L 16,3.3 L 14.6,5.4 L 15.5,7.5 L 18,8 L 18,10 L 15.5,10.5 L 14.6,12.6 L 16,14.7 L 14.7,16 L 12.6,14.6 L 10.5,15.5 L 10,18 L 8,18 L 7.5,15.5 L 5.4,14.6 L 3.3,16 L 2,14.7 L 3.4,12.6 L 2.5,10.5 L 0,10 L 0,8 L 2.5,7.5 L 3.4,5.4 L 2,3.3 L 3.3,2 L 5.4,3.4 L 7.5,2.5 Z M 9,6 A 3,3 0 1 0 9,12 A 3,3 0 1 0 9,6 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <Border Width="1" Height="20" Background="#26FFFFFF" Margin="12,0,4,0"/>
                    <Button Style="{StaticResource ChromeButton}" Click="Min_Click" ToolTip="свернуть">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Max_Click" ToolTip="развернуть">
                        <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" RadiusX="3" RadiusY="3"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="закрыть">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="96"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ======= Три большие кнопки ======= -->
                <Grid x:Name="CardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Telegram -->
                    <Border x:Name="TCard" Style="{StaticResource GlassCard}" Padding="24,20">
                        <Grid>
                            <Border CornerRadius="32" Background="{StaticResource GlassSheen}" Margin="-24,-20" IsHitTestVisible="False"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="telegram" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="32" Margin="0,-6,0,0"/>
                                        <TextBlock Text="прокси для telegram" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="1,0,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="TPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" CornerRadius="13" Padding="11,5" Background="#0FFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="TDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TStatus" Text="выключен" FontSize="11.5" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Viewbox x:Name="TBox" Grid.Row="1" StretchDirection="DownOnly" Margin="0,12">
                                    <Grid Width="216" Height="224">
                                        <Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Ellipse x:Name="TSpin" Width="194" Height="194" StrokeThickness="1.6" StrokeDashArray="14 70" StrokeDashCap="Round"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Stroke="White">
                                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <ToggleButton x:Name="TPower" Style="{StaticResource PowerButton}" Click="TPower_Click"
                                                      AutomationProperties.Name="{Binding Text, ElementName=TAction}" ToolTip="{Binding Text, ElementName=TAction}">
                                            <Path Data="{StaticResource PlaneIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  Stretch="Uniform" Width="50" Height="50" Margin="-4,3,0,0"/>
                                        </ToggleButton>
                                        <TextBlock x:Name="TAction" Grid.Row="1" Text="включить прокси" FontSize="13" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="TSub" Grid.Row="2" Text="прокси tgwsproxy" HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <Button x:Name="TCtrl" Grid.Row="3" Style="{StaticResource PillButton}" Click="TgLink_Click" Padding="12,12">
                                    <TextBlock Text="подключить в telegram"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Запрет -->
                    <Border x:Name="ZCard" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="24,20">
                        <Grid>
                            <Border CornerRadius="32" Background="{StaticResource GlassSheen}" Margin="-24,-20" IsHitTestVisible="False"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="запрет" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="32" Margin="0,-6,0,0"/>
                                        <TextBlock Text="youtube, discord и другие сайты" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="1,0,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="ZPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" CornerRadius="13" Padding="11,5" Background="#0FFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ZDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ZStatus" Text="выключен" FontSize="11.5" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Viewbox x:Name="ZBox" Grid.Row="1" StretchDirection="DownOnly" Margin="0,12">
                                    <Grid Width="216" Height="224">
                                        <Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Ellipse x:Name="ZSpin" Width="194" Height="194" StrokeThickness="1.6" StrokeDashArray="14 70" StrokeDashCap="Round"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Stroke="White">
                                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <ToggleButton x:Name="ZPower" Style="{StaticResource PowerButton}" Click="ZPower_Click"
                                                      AutomationProperties.Name="{Binding Text, ElementName=ZAction}" ToolTip="{Binding Text, ElementName=ZAction}">
                                            <Path Data="{StaticResource PowerIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="46" Height="46"/>
                                        </ToggleButton>
                                        <TextBlock x:Name="ZAction" Grid.Row="1" Text="включить запрет" FontSize="13" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="ZSub" Grid.Row="2" Text="готовлю…" HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <StackPanel x:Name="ZCtrl" Grid.Row="3">
                                    <Button x:Name="NetworkStrategyBtn" Style="{StaticResource PillButton}" Click="NetworkStrategy_Click"
                                            Visibility="Collapsed" Margin="0,0,0,8" Padding="8,6"/>
                                    <ComboBox x:Name="StrategyBox" Style="{StaticResource GlassCombo}" SelectionChanged="StrategyBox_SelectionChanged"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PickBtn" Style="{StaticResource AccentButton}" Padding="12,12" Click="Pick_Click">
                                            <TextBlock x:Name="PickBtnText" Text="подобрать лучшую" FontWeight="SemiBold"/>
                                        </Button>
                                        <Button x:Name="ZMoreBtn" Grid.Column="2" Style="{StaticResource PillButton}" Padding="14,12" Click="ZMore_Click" ToolTip="сервисы и тесты">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="сервисы и тесты"/>
                                                <Path x:Name="ZMoreArrow" Data="M0,0 L4,4 L8,0" Stroke="White" StrokeThickness="1.4" Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                                </Path>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- VPN -->
                    <Border x:Name="VCard" Grid.Column="4" Style="{StaticResource GlassCard}" Padding="24,20">
                        <Grid>
                            <Border CornerRadius="32" Background="{StaticResource GlassSheen}" Margin="-24,-20" IsHitTestVisible="False"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="vpn" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="32" Margin="0,-6,0,0"/>
                                        <TextBlock Text="ссылки и подписки как в happ и incy" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="1,0,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="VPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" CornerRadius="13" Padding="11,5" Background="#0FFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="VDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="VStatusPill" Text="выключен" FontSize="11.5" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Viewbox x:Name="VBox" Grid.Row="1" StretchDirection="DownOnly" Margin="0,12">
                                    <Grid Width="216" Height="224">
                                        <Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Ellipse x:Name="VSpin" Width="194" Height="194" StrokeThickness="1.6" StrokeDashArray="14 70" StrokeDashCap="Round"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Stroke="White">
                                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <ToggleButton x:Name="VPower" Style="{StaticResource PowerButton}" Click="VPower_Click"
                                                      AutomationProperties.Name="{Binding Text, ElementName=VAction}" ToolTip="{Binding Text, ElementName=VAction}">
                                            <Path Data="M 12,1.5 L 3,5 L 3,11 C 3,16.5 7,20.8 12,22.5 C 17,20.8 21,16.5 21,11 L 21,5 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineJoin="Round"
                                                  Stretch="Uniform" Width="42" Height="46"/>
                                        </ToggleButton>
                                        <TextBlock x:Name="VAction" Grid.Row="1" Text="подключить vpn" FontSize="13" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="VSub" Grid.Row="2" Text="добавьте ссылку" HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <StackPanel x:Name="VCtrl" Grid.Row="3">
                                    <Button x:Name="VpnRetryBtn" Style="{StaticResource PillButton}" Content="проверить снова" Click="VpnRetry_Click"
                                            Visibility="Collapsed" Margin="0,0,0,8" Padding="8,6"/>
                                <Button x:Name="VMoreBtn" Style="{StaticResource PillButton}" Padding="12,12" Click="VMore_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="VpnMoreLabel" Text="серверы и подписки"/>
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="White" StrokeThickness="1.4" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======= Выезжающая панель: сервисы, тесты, VPN, обновления, настройки ======= -->
                <Grid x:Name="DrawerHost" Grid.Row="1" Height="0" ClipToBounds="True">
                    <Border x:Name="Drawer" Style="{StaticResource GlassCard}" Margin="0,18,0,0" Padding="24,18,24,18" Opacity="0">
                        <Border.RenderTransform><TranslateTransform x:Name="DrawerT" Y="40"/></Border.RenderTransform>
                        <Grid>
                            <Border CornerRadius="32" Background="{StaticResource GlassSheen}" Margin="-24,-18" IsHitTestVisible="False"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Border HorizontalAlignment="Left" CornerRadius="23" Background="#0DFFFFFF" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="4">
                                        <Grid Width="560">
                                            <Border x:Name="SegHi" Width="112" HorizontalAlignment="Left" CornerRadius="19" Background="{StaticResource SolidWhite}">
                                                <Border.RenderTransform><TranslateTransform x:Name="SegHiT"/></Border.RenderTransform>
                                            </Border>
                                            <UniformGrid Columns="5">
                                                <RadioButton x:Name="TabServices" Style="{StaticResource SegButton}" Content="сервисы" IsChecked="True" Checked="Tab_Checked" Tag="0"/>
                                                <RadioButton x:Name="TabVpn" Style="{StaticResource SegButton}" Content="vpn" Checked="Tab_Checked" Tag="1"/>
                                                <RadioButton x:Name="TabTests" Style="{StaticResource SegButton}" Content="тесты" Checked="Tab_Checked" Tag="2"/>
                                                <RadioButton x:Name="TabUpdates" Style="{StaticResource SegButton}" Checked="Tab_Checked" Tag="3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="обновления" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                        <Ellipse x:Name="UpdDot" Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="6,1,0,0" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="TabSettings" Style="{StaticResource SegButton}" Content="настройки" Checked="Tab_Checked" Tag="4"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="DrawerCloseBtn" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" Click="CloseDrawer_Click" ToolTip="свернуть панель">
                                        <Path Data="M0,6 L6,0 L12,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Margin="0,-2,0,0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
                                        </Path>
                                    </Button>
                                </Grid>
                            <Grid x:Name="Pages" Grid.Row="1" Margin="0,18,0,0">
                                <!-- Сервисы -->
                                <Grid x:Name="PageServices">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="2,0,0,14">
                                        <TextBlock Text="что разблокировать" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27"/>
                                        <TextBlock Text="включённые сервисы попадают в списки запрета и используются в тестах и авто-подборе стратегии."
                                                   FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <ItemsControl x:Name="ServicesList" ItemTemplate="{StaticResource ServiceTpl}"/>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewSvcName" Style="{StaticResource GlassTextBox}" Tag="название"/>
                                        <TextBox x:Name="NewSvcDomains" Grid.Column="2" Style="{StaticResource GlassTextBox}" Tag="домены через запятую: example.com, cdn.example.com"/>
                                        <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="добавить" Click="AddService_Click"/>
                                    </Grid>
                                </Grid>

                                <!-- VPN -->
                                <Grid x:Name="PageVpn" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="2,0,0,12">
                                        <TextBlock Text="vpn" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27"/>
                                        <TextBlock Text="те же ссылки, что в happ и incy: подписки https://, vless://, vmess://, trojan://, ss://, happ://add/, incy://add/ и incy://crypt1/"
                                                   FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border x:Name="VpnCoreCard" Grid.Row="1" CornerRadius="24" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="18,12" Margin="0,0,0,10" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="VpnCoreText" Text="для vpn нужно ядро xray. оно скачается с github (около 16 мб)." FontSize="12.5" TextWrapping="Wrap"/>
                                                <Grid Height="3" Margin="0,8,0,0" x:Name="VpnCoreBarHost" Visibility="Collapsed">
                                                    <Border CornerRadius="1.5" Background="#1AFFFFFF"/>
                                                    <Border x:Name="VpnCoreBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource SolidWhite}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="VpnCoreBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Content="скачать" Click="VpnCore_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VpnInput" Style="{StaticResource GlassTextBox}" Tag="ссылка или подписка из happ или incy"/>
                                        <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="вставить" Click="VpnPaste_Click"/>
                                        <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="добавить" Click="VpnAdd_Click"/>
                                    </Grid>

                                    <Grid Grid.Row="3" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="VpnConnectBtn" Style="{StaticResource AccentButton}" Click="VpnConnect_Click" MinWidth="150">
                                            <TextBlock x:Name="VpnConnectText" Text="подключить"/>
                                        </Button>
                                        <ComboBox x:Name="VpnModeBox" Grid.Column="1" Style="{StaticResource GlassCombo}" Width="200" Margin="8,0,0,0" SelectionChanged="VpnMode_SelectionChanged">
                                            <ComboBoxItem Tag="proxy" Content="системный прокси"/>
                                            <ComboBoxItem Tag="tun" Content="весь трафик (tun)"/>
                                        </ComboBox>
                                        <Button Grid.Column="3" Style="{StaticResource PillButton}" Content="пинг" Click="VpnPing_Click" Margin="8,0,0,0"/>
                                        <Button Grid.Column="4" Style="{StaticResource PillButton}" Content="обновить" ToolTip="обновить подписки" Click="VpnRefresh_Click" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="2,0,0,8">
                                            <TextBlock x:Name="VpnStatus" Text="не подключено" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,220,0" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox x:Name="VpnRuDirect" Style="{StaticResource Switch}" HorizontalAlignment="Right" Content="российские сайты напрямую" FontSize="12.5" Click="VpnRuDirect_Click"/>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                            <ItemsControl x:Name="VpnList" ItemTemplate="{StaticResource VpnRowTpl}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <!-- Тесты -->
                                <Grid x:Name="PageTests" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel>
                                        <Button x:Name="TestCurrentBtn" Style="{StaticResource PillButton}" Content="проверить текущую" Click="TestCurrent_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="TestAllBtn" Style="{StaticResource AccentButton}" Content="тест всех стратегий" Click="TestAll_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="StopBtn" Style="{StaticResource PillButton}" Content="стоп" Click="Stop_Click" IsEnabled="False"/>
                                        <Button x:Name="RestoreStrategyBtn" Style="{StaticResource PillButton}" Content="вернуть предыдущую" Click="RestoreStrategy_Click"
                                                Visibility="Collapsed" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                                        <Grid>
                                            <TextBlock x:Name="TestSummary" Text="проверка открывает выбранные сервисы через tls 1.2, tls 1.3 и скачивает 64 кб, чтобы поймать «заморозку» на 16–20 кб."
                                                       FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,60,0"/>
                                            <TextBlock x:Name="TestPercent" HorizontalAlignment="Right" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Height="4" Margin="0,10,0,0">
                                            <Border CornerRadius="2" Background="#1AFFFFFF"/>
                                            <Border x:Name="TestBar" CornerRadius="2" Background="{StaticResource SolidWhite}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="TestBarS" ScaleX="0"/></Border.RenderTransform>
                                                <Border.Effect><DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <Grid>
                                            <ItemsControl x:Name="StrategyResults" ItemTemplate="{StaticResource StrategyRowTpl}"/>
                                            <ItemsControl x:Name="CheckResults" ItemTemplate="{StaticResource CheckRowTpl}" Visibility="Collapsed"/>
                                        </Grid>
                                    </ScrollViewer>
                                    <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="22" Background="#59000000" BorderBrush="#17FFFFFF" BorderThickness="1" Height="96">
                                        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SubTextBrush}"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="14,10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>

                                <!-- Обновления -->
                                <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                                    <TextBlock Text="обновления с github" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27"/>
                                    <TextBlock Text="программа хранит свои копии инструментов в c:\programdata\obhod. ваши исходные папки и батники не меняются."
                                               FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="zapret-discord-youtube" FontSize="14.5"/>
                                                <TextBlock x:Name="ZVer" Text="установлено: —   ·   на github: —" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                                                <Grid Height="3" Margin="0,10,0,0" x:Name="ZUpdBarHost" Visibility="Collapsed">
                                                    <Border CornerRadius="1.5" Background="#1AFFFFFF"/>
                                                    <Border x:Name="ZUpdBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource SolidWhite}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="ZUpdBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Content="обновить" Click="ZUpdate_Click" VerticalAlignment="Center" IsEnabled="False"/>
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="tg-ws-proxy" FontSize="14.5"/>
                                                <TextBlock x:Name="TVer" Text="установлено: —   ·   на github: —" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                                                <Grid Height="3" Margin="0,10,0,0" x:Name="TUpdBarHost" Visibility="Collapsed">
                                                    <Border CornerRadius="1.5" Background="#1AFFFFFF"/>
                                                    <Border x:Name="TUpdBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource SolidWhite}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="TUpdBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Content="обновить" Click="TUpdate_Click" VerticalAlignment="Center" IsEnabled="False"/>
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="14.5"><Run Text="xray"/><Run Text="  ·  ядро vpn" Foreground="{StaticResource SubTextBrush}" FontSize="12"/></TextBlock>
                                                <TextBlock x:Name="XVer" Text="установлено: —   ·   на github: —" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                                                <Grid Height="3" Margin="0,10,0,0" x:Name="XUpdBarHost" Visibility="Collapsed">
                                                    <Border CornerRadius="1.5" Background="#1AFFFFFF"/>
                                                    <Border x:Name="XUpdBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource SolidWhite}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="XUpdBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Content="скачать" Click="CoreUpdate_Click" Tag="X" VerticalAlignment="Center" IsEnabled="False"/>
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="14.5"><Run Text="sing-box"/><Run Text="  ·  для режима «весь трафик»" Foreground="{StaticResource SubTextBrush}" FontSize="12"/></TextBlock>
                                                <TextBlock x:Name="SVer" Text="установлено: —   ·   на github: —" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                                                <Grid Height="3" Margin="0,10,0,0" x:Name="SUpdBarHost" Visibility="Collapsed">
                                                    <Border CornerRadius="1.5" Background="#1AFFFFFF"/>
                                                    <Border x:Name="SUpdBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{StaticResource SolidWhite}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="SUpdBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Content="скачать" Click="CoreUpdate_Click" Tag="S" VerticalAlignment="Center" IsEnabled="False"/>
                                        </Grid>
                                    </Border>
                                    <WrapPanel>
                                        <Button Style="{StaticResource PillButton}" Content="проверить сейчас" Click="CheckUpdates_Click" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource PillButton}" Content="страница запрета" Click="OpenZapretPage_Click" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource PillButton}" Content="страница прокси" Click="OpenTgPage_Click" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource PillButton}" Content="страница vpn (xray)" Click="OpenVpnPage_Click" Tag="X" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource PillButton}" Content="страница sing-box" Click="OpenVpnPage_Click" Tag="S" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Настройки -->
                                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="настройки" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27" Margin="0,0,0,14"/>
                                        <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,8">
                                            <StackPanel>
                                                <CheckBox x:Name="SAutoZ" Style="{StaticResource Switch}" Margin="0,8" Click="Setting_Click" Content="включать запрет при запуске программы"/>
                                                <CheckBox x:Name="SAutoPick" Style="{StaticResource Switch}" Margin="0,8" Click="Setting_Click" Content="при запуске проверять стратегию и подбирать лучшую"/>
                                                <CheckBox x:Name="SAutoTg" Style="{StaticResource Switch}" Margin="0,8" Click="Setting_Click" Content="включать telegram-прокси при запуске программы"/>
                                                <CheckBox x:Name="SUpd" Style="{StaticResource Switch}" Margin="0,8" Click="Setting_Click" Content="проверять обновления при запуске"/>
                                                <CheckBox x:Name="SWin" Style="{StaticResource Switch}" Margin="0,8" Click="Autostart_Click" Content="запускать вместе с windows (в трее)"/>
                                                <CheckBox x:Name="STray" Style="{StaticResource Switch}" Margin="0,8" Click="Setting_Click" Content="кнопка «закрыть» сворачивает в трей"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="28" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="игровой фильтр" FontSize="13.5"/>
                                                    <TextBlock Text="обход для игр на портах 1024–65535. включайте, только если игра не подключается."
                                                               FontSize="11.5" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                                </StackPanel>
                                                <ComboBox x:Name="GameBox" Grid.Column="1" Style="{StaticResource GlassCombo}" SelectionChanged="GameBox_SelectionChanged">
                                                    <ComboBoxItem Tag="disabled" Content="выключен"/>
                                                    <ComboBoxItem Tag="all" Content="tcp и udp"/>
                                                    <ComboBoxItem Tag="tcp" Content="только tcp"/>
                                                    <ComboBoxItem Tag="udp" Content="только udp"/>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Style="{StaticResource PillButton}" Content="мои домены" Click="OpenUserList_Click" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource PillButton}" Content="исключения" Click="OpenExcludeList_Click" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource PillButton}" Content="папка программы" Click="OpenFolder_Click" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource AccentButton}" Content="dns-серверы" Click="OpenDns_Click" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource PillButton}" Content="журнал" Click="OpenLog_Click" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,10,0,0"
                                                   Text="стратегии с подписью davl — авторские, добавлены в «обход». авто-подбор проверяет их наравне со штатными стратегиями flowseal. если антивирус ругается на winws.exe, добавьте папку c:\programdata\obhod в исключения: это драйвер windivert, он нужен для работы запрета."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======= Всплывающее уведомление ======= -->
        <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44" CornerRadius="24" Padding="22,13"
                Background="#F00C0C0E" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" MaxWidth="660">
            <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.8"/></Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="ToastT" Y="20"/></Border.RenderTransform>
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
