<Window x:Class="Obhod.DnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dns-серверы" Width="640" Height="660" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" Background="#1C1C1E" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="70" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="DnsRowTpl">
            <Border Margin="0,0,0,8" Padding="16,10" CornerRadius="24" Background="{Binding RowBrush}" BorderBrush="{Binding RowStroke}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Badge, Mode=OneWay}" Foreground="#FF30D158" FontSize="11.5"/></TextBlock>
                        <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding PingBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PingText}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PillButton}" Padding="16,8" Content="{Binding ButtonText}" Click="Apply_Click" Tag="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="{DynamicResource BgBrush}"/>
        <Border Margin="14" Style="{StaticResource GlassCard}" Padding="26,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="dns-серверы" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27"/>
                        <TextBlock Text="выберите сервер с наименьшим пингом. dns влияет на скорость открытия сайтов, а некоторые серверы открывают сервисы с геоблоком."
                                   FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,40,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" ToolTip="закрыть">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" CornerRadius="18" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="16,10" Margin="0,14,0,12">
                    <TextBlock x:Name="CurrentText" Text="сейчас: …" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl x:Name="List" ItemTemplate="{StaticResource DnsRowTpl}"/>
                </ScrollViewer>
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="PingBtn" Style="{StaticResource PillButton}" Content="проверить пинг" HorizontalAlignment="Left" Click="Ping_Click"/>
                    <Button x:Name="ResetBtn" Style="{StaticResource AccentButton}" Content="вернуть dns провайдера" HorizontalAlignment="Right" Click="Reset_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
